{
	"version": 2,
	"configurePresets": [
		{
			"name": "common",
			"hidden": true,
			"generator": "Ninja",
			"cacheVariables": {
				"CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
			}
		},
		{
			"name": "debug",
			"inherits": "common",
			"binaryDir": "build-debug",
			"cacheVariables": {
				"CMAKE_BUILD_TYPE": "Debug"
			}
		},
		{
			"name": "release",
			"inherits": "common",
			"binaryDir": "build-release",
			"cacheVariables": {
				"CMAKE_BUILD_TYPE": "Release"
			}
		},
		{
			"name": "msvc-debug",
			"inherits": "debug",
			"generator": "Visual Studio 17 2022"
		},
		{
			"name": "msvc-release",
			"inherits": "release",
			"generator": "Visual Studio 17 2022"
		},
		{
			"name": "mingw",
			"hidden": true,
			"description": "MSYS2 UCRT64 GCC. Ninja instead of MinGW Makefiles: old mingw32-make breaks non-ASCII paths. MSYS2 goes first in PATH, so Git Bash DLLs don't break the compiler",
			"cacheVariables": {
				"CMAKE_C_COMPILER": "gcc",
				"CMAKE_CXX_COMPILER": "g++"
			},
			"environment": {
				"PATH": "C:/msys64/ucrt64/bin;$penv{PATH}"
			}
		},
		{
			"name": "mingw-debug",
			"inherits": ["mingw", "debug"]
		},
		{
			"name": "mingw-release",
			"inherits": ["mingw", "release"]
		}
	],
	"buildPresets": [
		{
			"name": "mingw-debug",
			"configurePreset": "mingw-debug"
		},
		{
			"name": "mingw-release",
			"configurePreset": "mingw-release"
		}
	]
}
